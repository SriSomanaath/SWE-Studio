{
 "title": "SWE Studio: agents, cluster, GPU",
 "uid": "swe-studio",
 "schemaVersion": 39,
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "refresh": "30s",
 "tags": [
  "swe-studio"
 ],
 "editable": true,
 "panels": [
  {
   "type": "row",
   "title": "Agent runs (selected time range)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Pass rate (resolved / evaluated)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (model) (increase(agent_evals_total{result=\"resolved\"}[$__range])) / sum by (model) (increase(agent_evals_total[$__range]))",
     "legendFormat": "{{model}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "value_and_name"
   },
   "description": "Verdicts posted by scripts/bench_swebench.py via /ingest?eval=."
  },
  {
   "type": "stat",
   "title": "LLM cost per task",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (model) (increase(agent_cost_usd_total[$__range])) / sum by (model) (increase(agent_runs_finished_total[$__range]))",
     "legendFormat": "{{model}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "value_and_name"
   },
   "description": "API spend only; self-hosted vLLM is $0 here, its GPU cost is per node-hour."
  },
  {
   "type": "stat",
   "title": "Prompt cache hit rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (model) (increase(llm_tokens_total{kind=\"cached\"}[$__range])) / sum by (model) (increase(llm_tokens_total{kind=\"prompt\"}[$__range]))",
     "legendFormat": "{{model}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "value_and_name"
   },
   "description": "Share of prompt tokens served from the provider cache (app/agent/llm.py)."
  },
  {
   "type": "stat",
   "title": "Max parallel runner Jobs",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max_over_time(sum(kube_job_status_active{namespace=\"swe-studio\"})[$__range:30s])",
     "legendFormat": "jobs",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "value_and_name"
   }
  },
  {
   "type": "timeseries",
   "title": "Runs per minute",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (model) (rate(agent_runs_started_total[5m])) * 60",
     "legendFormat": "started {{model}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (model) (rate(agent_runs_finished_total[5m])) * 60",
     "legendFormat": "finished {{model}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Run wall time (launch to trajectory)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 6,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le, model) (rate(agent_run_duration_seconds_bucket[$__rate_interval])))",
     "legendFormat": "p50 {{model}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, model) (rate(agent_run_duration_seconds_bucket[$__rate_interval])))",
     "legendFormat": "p95 {{model}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {},
   "description": "Includes Job scheduling and Karpenter node scale-up, not just the agent loop."
  },
  {
   "type": "timeseries",
   "title": "Runner Jobs: active vs failed (infra)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 6,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(kube_job_status_active{namespace=\"swe-studio\"})",
     "legendFormat": "active",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(kube_job_status_failed{namespace=\"swe-studio\"})",
     "legendFormat": "failed (OOM / deadline / eviction)",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "description": "Agent failures show up as exit_status; these are pods that died before reporting."
  },
  {
   "type": "row",
   "title": "Cluster + GPU",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Nodes by Karpenter pool",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count by (label_swe_studio_pool, label_karpenter_sh_capacity_type) (kube_node_labels{label_swe_studio_pool!=\"\"})",
     "legendFormat": "{{label_swe_studio_pool}} {{label_karpenter_sh_capacity_type}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "description": "GPU pool should drop to 0 a few minutes after vLLM is scaled to 0."
  },
  {
   "type": "timeseries",
   "title": "GPU utilisation",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 15,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "avg by (Hostname) (DCGM_FI_DEV_GPU_UTIL)",
     "legendFormat": "{{Hostname}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "vLLM tokens / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 15,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(vllm:generation_tokens_total[1m]))",
     "legendFormat": "generated",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(vllm:prompt_tokens_total[1m]))",
     "legendFormat": "prompt",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "vLLM requests (continuous batching)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 15,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(vllm:num_requests_running)",
     "legendFormat": "running (in batch)",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(vllm:num_requests_waiting)",
     "legendFormat": "waiting",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  }
 ]
}