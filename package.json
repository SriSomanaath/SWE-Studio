{
  "name": "swe-studio",
  "private": true,
  "version": "0.1.0",
  "description": "SWE Studio — a professional, open-source observability and replay UI for coding agents. Phase 1: read-only trajectory viewer for studio .traj files.",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @swe-studio/web dev",
    "dev:api": "pnpm --filter @swe-studio/api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
